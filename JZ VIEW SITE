<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Discipline Into Wealth</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Manrope', sans-serif;
            background-color: #000;
            overflow: hidden;
            height: 100vh;
        }
        
        .smoke {
            position: absolute;
            width: 100%;
            height: 100%;
            background: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" preserveAspectRatio="none"><path fill="rgba(255,255,255,0.02)" d="M0,0 L100,0 L100,100 L0,100 Z"><animate attributeName="opacity" values="0.03;0.06;0.03" dur="15s" repeatCount="indefinite"/></path></svg>');
            background-size: cover;
            opacity: 0.1;
            animation: smoke 15s infinite alternate;
        }
        
        @keyframes smoke {
            0% { transform: scale(1) rotate(0deg); opacity: 0.03; }
            50% { transform: scale(1.1) rotate(1deg); opacity: 0.06; }
            100% { transform: scale(1) rotate(0deg); opacity: 0.03; }
        }
        
        .glow-button {
            transition: all 0.3s ease;
            box-shadow: 0 0 0 rgba(255, 255, 255, 0);
        }
        
        .glow-button:hover {
            box-shadow: 0 0 15px rgba(255, 255, 255, 0.7);
            transform: translateY(-2px);
        }
        
        .pulse {
            animation: pulse 2s infinite;
        }
        
        @keyframes pulse {
            0% { transform: scale(1); }
            50% { transform: scale(1.02); }
            100% { transform: scale(1); }
        }

        .fade-black {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: black;
            z-index: 20;
            opacity: 0;
            pointer-events: none;
            transition: opacity 1s ease;
        }

        .ready-text {
            position: fixed;
            top: 20%;
            left: 0;
            width: 100%;
            text-align: center;
            font-size: 4rem;
            font-weight: bold;
            z-index: 30;
            opacity: 0;
            pointer-events: none;
        }

        .ready-text span {
            display: inline-block;
            transform: translateY(100%);
            opacity: 0;
            transition: all 0.3s ease;
        }

        .links-container {
            position: fixed;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            z-index: 40;
            opacity: 0;
            pointer-events: none;
            display: flex;
            flex-direction: column;
            gap: 1rem;
            align-items: center;
        }

        .link-button {
            padding: 1rem 2rem;
            border: 2px solid white;
            border-radius: 9999px;
            font-weight: bold;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.5s cubic-bezier(0.68, -0.6, 0.32, 1.6);
            min-width: 250px;
            text-align: center;
            transform: scale(0);
            opacity: 0;
        }

        .link-button:hover {
            background-color: white;
            color: black;
        }
    </style>
</head>
<body class="relative flex items-center justify-center text-white">
    <div class="smoke"></div>
    
    <div class="absolute inset-0 bg-gradient-to-b from-black/80 to-black/30 z-0"></div>
    
    <main class="relative z-10 text-center px-6 max-w-4xl mx-auto pulse">
        <div class="mb-8">
            <h1 class="text-5xl md:text-7xl font-extrabold leading-tight mb-6">
                <span class="bg-clip-text text-transparent bg-gradient-to-r from-white to-gray-300">
                    Turn Discipline Into Wealth.
                </span>
                <span class="block text-red-500">Guaranteed.</span>
            </h1>
            <p class="text-xl md:text-2xl text-gray-300 font-medium max-w-2xl mx-auto leading-relaxed">
                Helping young men master trading, mindset, and masculinity — or your money back.
            </p>
        </div>
        
        <button class="glow-button border-2 border-white px-12 py-4 rounded-full text-lg font-bold uppercase tracking-wider hover:bg-white hover:text-black transition-all duration-300">
            Join the Movement
        </button>
        
        <div class="mt-16 flex justify-center space-x-6">
            <div class="w-16 h-1 bg-gradient-to-r from-red-500 to-transparent"></div>
            <div class="w-16 h-1 bg-gradient-to-l from-red-500 to-transparent"></div>
        </div>
    </main>

    <div class="fade-black"></div>
    <div class="ready-text"></div>
    <div class="links-container">
        <div class="link-button" data-link="https://www.instagram.com/333j999/">Instagram</div>
        <div class="link-button" data-link="https://discord.gg/v4By92M2C8">Discord</div>
        <div class="link-button" data-link="https://whop.com/jz-view/?a=jzview">Join Program</div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            const main = document.querySelector('main');
            const fadeBlack = document.querySelector('.fade-black');
            const readyText = document.querySelector('.ready-text');
            const linksContainer = document.querySelector('.links-container');
            const linkButtons = document.querySelectorAll('.link-button');
            
            let floatY = 0;
            let floatX = 0;
            let floatDirectionY = 0.2;
            let floatDirectionX = 0.1;
            
            function floatAnimation() {
                floatY += floatDirectionY;
                floatX += floatDirectionX;
                
                if (Math.abs(floatY) > 5) floatDirectionY *= -1;
                if (Math.abs(floatX) > 3) floatDirectionX *= -1;
                
                main.style.transform = `translate(${floatX}px, ${floatY}px)`;
                requestAnimationFrame(floatAnimation);
            }
            
            floatAnimation();
            
            // Button click effect
            const button = document.querySelector('.glow-button');
            button.addEventListener('click', () => {
                button.classList.add('animate-ping');
                setTimeout(() => {
                    button.classList.remove('animate-ping');
                    
                    // Fade to black
                    fadeBlack.style.opacity = 1;
                    fadeBlack.style.pointerEvents = 'auto';
                    
                    setTimeout(() => {
                        // Show "you ready?" text with character animation
                        readyText.innerHTML = 'you..ready?'.split('').map(char => 
                            `<span style="transition-delay: ${Math.random() * 0.3}s">${char}</span>`
                        ).join('');
                        readyText.style.opacity = 1;
                        
                        // Animate each character
                        setTimeout(() => {
                            const chars = readyText.querySelectorAll('span');
                            chars.forEach(char => {
                                char.style.transform = 'translateY(0)';
                                char.style.opacity = 1;
                            });
                            
                            // Show links after text animation with staggered bounce
                            setTimeout(() => {
                                linksContainer.style.opacity = 1;
                                linksContainer.style.pointerEvents = 'auto';
                                
                                const buttons = linksContainer.querySelectorAll('.link-button');
                                buttons.forEach((button, index) => {
                                    button.style.transform = 'scale(0)';
                                    button.style.opacity = '0';
                                    button.style.transition = 'all 0.5s cubic-bezier(0.68, -0.6, 0.32, 1.6)';
                                    
                                    setTimeout(() => {
                                        button.style.transform = 'scale(1)';
                                        button.style.opacity = '1';
                                    }, index * 200);
                                });
                            }, 1500);
                        }, 100);
                    }, 1000);
                }, 500);
            });
            
            // Handle link button clicks
            linkButtons.forEach(button => {
                button.addEventListener('click', (e) => {
                    window.open(e.target.dataset.link, '_blank');
                });
            });
        });
    </script>
</body>
</html>
